# AirSaathi AI Frontend Environment Configuration Template
# Copy this file to .env (or .env.local) and populate with your Firebase credentials.
# NEVER commit real credentials to Git.

# Firebase Web App Credentials (from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Backend API Base URL (defaults to http://localhost:8000 if not specified)
VITE_API_BASE_URL=http://localhost:8000
