# AirSaathi AI Backend Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# NEVER commit the actual .env file or credentials to Git.

ENVIRONMENT=development
API_V1_STR=/api/v1
VERSION=0.1.0

# Gemini API Integration (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-2.5-flash

# CPCB Real Time Air Quality Index (https://data.gov.in/)
# Resource ID: 3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
DATAGOVIN_API_KEY=your_datagovin_api_key_here

# OpenAQ API v3 Integration (Optional / Fallback)
OPENAQ_API_KEY=your_openaq_api_key_here

# Cache duration in seconds (15 minutes default)
AQI_CACHE_TTL_SECONDS=900

# Set to False to prefer live CPCB data when DATAGOVIN_API_KEY is configured
MOCK_MODE=False
