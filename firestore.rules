rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is accessing their own record
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to verify that client writes do not tamper with privileged administrative flags
    function hasNoPrivilegedFieldChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'is_admin', 'admin', 'permissions', 'claims']);
    }

    // User profiles & family settings
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && (!request.resource.data.keys().hasAny(['role', 'is_admin', 'admin', 'permissions', 'claims']));
      allow update: if isOwner(userId) && hasNoPrivilegedFieldChanges();
      allow delete: if isOwner(userId);
      
      // Subcollections under user
      match /routines/{routineId} {
        allow read, write: if isOwner(userId);
      }
      
      match /chat_sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      match /indoor_devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      match /saved_routes/{routeId} {
        allow read, write: if isOwner(userId);
      }

      match /impact_logs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public / Cached AQI sensor and station records (read-only for clients, managed by backend service)
    match /aqi_stations/{stationId} {
      allow read: if true;
      allow write: if false; // Only backend admin SDK can update
    }

    // Public educational and health advisory content
    match /health_advisories/{advisoryId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
